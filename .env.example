# Copy to .env (or set in your host's environment). Everything is optional:
# without providers, messages are logged as "simulated" so you can try the CRM safely.

PORT=3000
# Public URL of this server. Needed for email tracking links, unsubscribe links, and Twilio webhooks.
APP_URL=http://localhost:3000
# Signs unsubscribe links. Auto-generated and stored in the database if unset.
APP_SECRET=
# SQLite database location (default: ./data/crm.db)
DB_PATH=

# AI assistant (Claude). Without it, the assistant uses built-in templates and keyword rules.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Texting + click-to-call (Twilio). Register your number for A2P 10DLC in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+19515550000

# Email (any SMTP provider: Google Workspace, Microsoft 365, SendGrid, Postmark, SES…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Name <you@yourcompany.com>"

# Google Contacts sync (read-only). Create an OAuth client (type "Web application") in Google Cloud Console,
# enable the People API, and add this redirect URI: {APP_URL}/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Property data: automated home value (AVM), property facts, last sale, recorded mortgage.
# Address standardization via the US Census geocoder works without a key.
ATTOM_API_KEY=
