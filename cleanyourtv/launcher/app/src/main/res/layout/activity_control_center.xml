<?xml version="1.0" encoding="utf-8"?>
<!-- Control Center (control_center): a sheet of smoked glass on the right, over Home or any app. The clock and the
     network on top, then a grid of tiles for the settings people reach for. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/control_scrim">

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="28dp"
        android:orientation="vertical"
        android:background="@drawable/control_center_bg"
        android:elevation="16dp"
        android:padding="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="@string/control_center"
            android:textColor="#8CFFFFFF"
            android:textSize="11sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.22"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF"
                android:textSize="40sp"
                android:fontFamily="@string/font_light"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:gravity="left"
                android:singleLine="true"
                android:ellipsize="end"
                android:format12Hour="@string/date_format_home"
                android:format24Hour="@string/date_format_home"
                android:textColor="#A6FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@string/font_regular"
                android:letterSpacing="0.12"
                android:textAllCaps="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/networkDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/networkStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </LinearLayout>
</FrameLayout>
