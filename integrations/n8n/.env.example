# integrations/n8n/.env.example — variable NAMES only. Copy to .env (gitignored) and let
# install.sh fill the two secrets locally; never paste a value into this file or commit .env.
#
# Loopback only. Nothing here is reachable off 127.0.0.1 unless Steven changes N8N_HOST himself.

# --- Network (loopback only) ---
N8N_HOST=127.0.0.1
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://127.0.0.1:5678/

# --- Storage ---
# Default (sqlite) is fine for a single-Mac, low-volume bridge. Data directory: ./data
# (docker-compose.yml bind-mounts it; the npm path uses N8N_USER_FOLDER below).
N8N_USER_FOLDER=./data
DB_TYPE=sqlite

# --- Behavior ---
GENERIC_TIMEZONE=America/Los_Angeles
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
# n8n 2.x blocks $env in expressions by default (see docs/examples/n8n/README.md in the OpenWA
# clone) -- workflows here paste literal values into node parameters instead, never $env.

# --- Secrets (NAMES only; install.sh generates the VALUES locally with openssl rand) ---
# Encrypts n8n's own credential store at rest. Never move this key between Macs by copying
# .env -- if it must move, move data/ and the key together, or credentials become unreadable.
N8N_ENCRYPTION_KEY=
# Shared token the OpenWA-bridge webhook checks via a Header Auth credential (X-Webhook-Token).
# The SAME value also becomes OpenWA's own webhook "secret" (HMAC) when C1 registers the
# webhook -- see workflows/openwa-selfchat-to-vanessa.json and its header comment.
OPENWA_WEBHOOK_TOKEN=
