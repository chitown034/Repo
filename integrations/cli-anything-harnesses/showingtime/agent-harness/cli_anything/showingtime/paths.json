{
  "site": "showingtime",
  "site_title": "ShowingTime",
  "_comment": "UNVERIFIED path map. Every recipe is a best-effort guess at ShowingTime's agent web app, written without seeing it (the host is egress-blocked from the build sandbox). Run `cli-anything-showingtime recipe <name> --discover --json` on the Mac, fix root / rows.prefix / fields, and set verified:true only after the numbers match the page. If your MLS signs you in through SSO/MFA, sign in by hand in Chrome first — this harness never types credentials.",
  "hosts": ["showingtime.com"],
  "auth": {
    "logged_in_markers": ["Sign Out", "Sign out", "Log Out", "Log out", "My Profile", "My Account"],
    "logged_out_markers": ["Sign In", "Sign in", "Log In", "Log in", "Forgot Password", "Forgot password"],
    "login_url_fragments": ["/login", "/signin", "/sign-in", "/auth/", "/sso"]
  },
  "recipes": {
    "todays-showings": {
      "kind": "list",
      "description": "Today's appointments on Steven's listings and for his buyers (needs sign-in)",
      "url": "https://app.showingtime.com/appointments",
      "url_required": false,
      "requires_auth": true,
      "requires_match": false,
      "root": ["/main"],
      "rows": {"prefix": ["listitem", "article", "row", "group"], "role": ["listitem", "article", "row"]},
      "depth": 1,
      "fields": {
        "time":             {"regex": "(\\d{1,2}:\\d{2}\\s*[AaPp][Mm](?:\\s*[-–]\\s*\\d{1,2}:\\d{2}\\s*[AaPp][Mm])?)"},
        "address":          {"prefix": ["link", "heading"], "index": 0},
        "status":           {"regex": "(Confirmed|Pending|Requested|Cancelled|Canceled|Declined|Completed|Rescheduled)"},
        "appointment_type": {"regex": "(Showing|Inspection|Appraisal|Walk-?Through|Open House)"},
        "showing_agent":    {"regex": "(?:Showing Agent|Buyer'?s? Agent|Agent)\\s*:?\\s*([^\\n]+)", "group": 1},
        "side":             {"regex": "\\b(Listing|Buyer)\\b(?:\\s*Side)?", "group": 1}
      },
      "verified": false
    },
    "showing-status": {
      "kind": "list",
      "description": "Status of one appointment, picked by --match (address, agent or id)",
      "url": "https://app.showingtime.com/appointments",
      "url_required": false,
      "requires_auth": true,
      "requires_match": true,
      "root": ["/main"],
      "rows": {"prefix": ["listitem", "article", "row", "group"], "role": ["listitem", "article", "row"]},
      "depth": 1,
      "fields": {
        "time":          {"regex": "(\\d{1,2}:\\d{2}\\s*[AaPp][Mm](?:\\s*[-–]\\s*\\d{1,2}:\\d{2}\\s*[AaPp][Mm])?)"},
        "date":          {"regex": "(\\d{1,2}/\\d{1,2}/\\d{2,4}|(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\.? \\d{1,2}(?:, \\d{4})?)"},
        "address":       {"prefix": ["link", "heading"], "index": 0},
        "status":        {"regex": "(Confirmed|Pending|Requested|Cancelled|Canceled|Declined|Completed|Rescheduled)"},
        "showing_agent": {"regex": "(?:Showing Agent|Buyer'?s? Agent|Agent)\\s*:?\\s*([^\\n]+)", "group": 1}
      },
      "verified": false
    },
    "feedback-inbox": {
      "kind": "list",
      "description": "Showing feedback received on Steven's listings (needs sign-in)",
      "url": "https://app.showingtime.com/feedback",
      "url_required": false,
      "requires_auth": true,
      "requires_match": false,
      "root": ["/main"],
      "rows": {"prefix": ["listitem", "article", "row", "group"], "role": ["listitem", "article", "row"]},
      "depth": 1,
      "fields": {
        "address":       {"prefix": ["link", "heading"], "index": 0},
        "showing_date":  {"regex": "(\\d{1,2}/\\d{1,2}/\\d{2,4}|(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\.? \\d{1,2}(?:, \\d{4})?)"},
        "agent":         {"regex": "(?:From|Agent|Submitted by)\\s*:?\\s*([^\\n]+)", "group": 1},
        "interest":      {"regex": "(Very Interested|Somewhat Interested|Not Interested|No Interest|Interested|Undecided)"},
        "price_opinion": {"regex": "(Priced Right|Too High|Too Low|Overpriced|Underpriced|Fair)"},
        "comment":       {"prefix": ["paragraph", "text"], "index": 0}
      },
      "verified": false
    },
    "my-listing-activity": {
      "kind": "list",
      "description": "Per-listing showing and feedback counts for Steven's listings (needs sign-in)",
      "url": "https://app.showingtime.com/listings",
      "url_required": false,
      "requires_auth": true,
      "requires_match": false,
      "root": ["/main"],
      "rows": {"prefix": ["listitem", "article", "row", "group"], "role": ["listitem", "article", "row"]},
      "depth": 1,
      "fields": {
        "address":        {"prefix": ["link", "heading"], "index": 0},
        "mls_id":         {"regex": "MLS\\s*#?\\s*:?\\s*([A-Z0-9-]{4,})", "group": 1},
        "status":         {"regex": "(Active|Pending|Under Contract|Withdrawn|Expired|Sold|Closed)"},
        "showings":       {"regex": "(\\d+)\\s*(?:showings?|appointments?)", "group": 1},
        "feedback_count": {"regex": "(\\d+)\\s*feedback", "group": 1},
        "last_showing":   {"regex": "(?:Last (?:Showing|Activity))\\s*:?\\s*([^\\n]+)", "group": 1}
      },
      "verified": false
    }
  }
}
