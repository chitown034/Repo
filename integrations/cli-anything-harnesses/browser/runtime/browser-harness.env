# Process environment for the vendored cli-anything-browser harness.
#
# WHY A FILE AND NOT A PATCH: cli_anything/browser/utils/security.py reads
# CLI_ANYTHING_BROWSER_BLOCK_PRIVATE at MODULE IMPORT TIME (security.py:22).
# Exporting it after the harness process has started does nothing. It has to
# be in the environment before the interpreter starts, which is what this file
# and run-browser-harness.sh are for.
#
# Sourcing it by hand:
#     set -a; . browser-harness.env; set +a
# run-browser-harness.sh does that for you.
#
# NO SECRET VALUES LIVE HERE. DOMSHELL_TOKEN is named at the bottom and never
# written — see SECURITY-POSTURE.md, finding F-P1-03.

# ── F-P1-05: SSRF. Refuse loopback, RFC-1918, link-local (incl. 169.254.169.254).
# Upstream default is OFF ("allow localhost/private networks for development").
# For Steven's installation it is ON.
CLI_ANYTHING_BROWSER_BLOCK_PRIVATE=true

# Allowed URL schemes. Upstream default is "http,https"; dangerous schemes
# (file:, javascript:, data:, chrome-extension:, …) are refused regardless.
# Optional tightening: every one of the seven site targets is https-only, so
#     CLI_ANYTHING_BROWSER_ALLOWED_SCHEMES=https
# costs nothing and closes a downgrade path. Left at the default here so this
# file changes exactly one upstream behaviour; flip it after the ECC review.
CLI_ANYTHING_BROWSER_ALLOWED_SCHEMES=http,https

# ── F-P1-02: supply chain. The harness spawns `npx -p @apireno/domshell
# domshell-proxy` with no version pin, so npx runs whatever the registry
# serves at call time. These two point that spawn at a lockfile-pinned,
# integrity-checked local copy instead. bin/npx refuses to resolve the
# package any other way; see SECURITY-POSTURE.md.
CLI_ANYTHING_DOMSHELL_PIN_DIR=$HOME/Applications/cli-anything-harnesses/domshell-pin
CLI_ANYTHING_DOMSHELL_PINNED_VERSION=2.0.10

# Quieter, and one less reason for npm to talk to the network.
npm_config_audit=false
npm_config_fund=false

# ── Named, never set here ────────────────────────────────────────────────
# DOMSHELL_TOKEN  — auth token of the running DOMShell server. A credential:
#                   Steven sets it in his own shell/keychain. Never written to
#                   a repo file. It is passed to the proxy in argv and is
#                   therefore visible in `ps` — the open residual of F-P1-03.
# DOMSHELL_PORT   — MCP HTTP port of the running server (upstream default 3001).
