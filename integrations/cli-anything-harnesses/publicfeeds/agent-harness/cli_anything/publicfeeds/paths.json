    "veterans-united-va-rates": {
      "kind": "list",
      "description": "Veterans United's published VA mortgage rate table (public; no sign-in, no quote requested)",
      "policy_group": "lenderrates",
      "writes_into": "ratesSnapshot.rates[] (program prefixed VA)",
      "url": "https://www.veteransunited.com/va-loans/va-mortgage-rates/",
      "url_required": false,
      "requires_auth": false,
      "requires_match": false,
      "root": [
        "/main"
      ],
      "rows": {
        "prefix": [
          "row",
          "listitem",
          "group"
        ],
        "role": [
          "row"
        ]
      },
      "depth": 1,
      "fields": {
        "program": {
          "prefix": [
            "heading",
            "link",
            "cell"
          ],
          "index": 0
        },
        "rate": {
          "regex": "([\\d.]+)\\s*%",
          "group": 1
        },
        "apr": {
          "regex": "([\\d.]+)\\s*%\\s*APR",
          "group": 1
        },
        "asOf": {
          "regex": "(?:[Vv]alid|[Rr]ates?)\\s+as\\s+of\\s+([A-Za-z]+\\.?\\s+\\d{1,2}(?:st|nd|rd|th)?,?\\s+\\d{4})",
          "group": 1
        }
      },
      "verified": false
    },
