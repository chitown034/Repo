{
  "site": "publicfeeds",
  "site_title": "public real-estate & lender research pages",
  "_comment": "UNVERIFIED path map, written 2026-09-24 without ever reaching any of these six hosts (all egress-blocked from the build sandbox, same as every other package in this repo). Every root/rows/field below is a best-effort guess, not an observation. Run `cli-anything-publicfeeds recipe <name> --discover --text` on the Mac once each group's policy gate is open, then fix root / rows.prefix / fields and set verified:true only after the numbers match the page. Edit a copy (`paths init`), not the packaged file. Selectors unverified — --discover on the Mac is the only way to correct them.",
  "hosts": [
    "redfin.com",
    "veteransunited.com",
    "navyfederal.org",
    "drhorton.com",
    "lennar.com",
    "richmondamerican.com"
  ],
  "auth": {
    "logged_in_markers": [],
    "logged_out_markers": [],
    "login_url_fragments": [
      "/login",
      "/signin",
      "/sign-in",
      "/account/login"
    ]
  },
  "recipes": {
    "temecula-market": {
      "kind": "record",
      "description": "Redfin's Temecula, CA housing-market page: median price, DOM, YoY, months of supply (public; no sign-in)",
      "policy_group": "marketpages",
      "writes_into": "ratesSnapshot.markets[] (name: \"Temecula, CA\")",
      "url": "https://redfin.com/city/19701/CA/Temecula/housing-market",
      "url_required": false,
      "requires_auth": false,
      "requires_match": false,
      "root": [
        "/main"
      ],
      "depth": 2,
      "fields": {
        "medianPrice": {
          "regex": "Median\\s+(?:Sale\\s+)?Price[^$\\n]{0,20}\\$([\\d,]+)",
          "group": 1
        },
        "dom": {
          "regex": "(\\d+)\\s*(?:Median\\s+)?Days?\\s+on\\s+Market",
          "group": 1
        },
        "yoy": {
          "regex": "([+-]?\\d+(?:\\.\\d+)?%)\\s*(?:YoY|year.over.year|vs\\.?\\s*last\\s*year)",
          "group": 1
        },
        "monthsSupply": {
          "regex": "([\\d.]+)\\s*[Mm]onths?\\s+of\\s+[Ss]upply",
          "group": 1
        },
        "asOf": {
          "regex": "(?:[Dd]ata\\s+(?:as\\s+of|through)|[Pp]eriod\\s+ending)\\s*([A-Za-z]+\\.?\\s+\\d{1,2},?\\s+\\d{4})",
          "group": 1
        }
      },
      "verified": false
    },
