# OpenWA — Steven's Mac settings, NAMES ONLY (R9, 2026-09-27)
#
# This is NOT a replacement for OpenWA's own .env.example (~800 lines, ships inside the clone
# install.sh makes at ~/Applications/openwa/.env.example) — that file is the single source of truth
# for every setting OpenWA has. This file is the short list of values Steven's deployment needs to
# set or verify, one variable per line, values-as-names-only per the router's HALT rule. Copy the
# lines below into ~/Applications/openwa/.env (install.sh does this for you) — anything not listed
# here keeps OpenWA's own default, which is already loopback-safe out of the box via Docker Compose.
#
# NEVER put a real key, token or Steven's phone number in this file or in .env. This file only ever
# holds variable NAMES and the non-secret values decided in R9 (engine choice, ports, feature flags).

# --- Core ---
NODE_ENV=production
PORT=2785
# The host-side port docker-compose.yml publishes to. That file already hardcodes the HOST half
# as 127.0.0.1 (`'127.0.0.1:${API_PORT:-2785}:2785'`) — API_PORT only changes which local port it
# lands on. Loopback-only is real because of that hardcoded host, not because of a setting here:
# the app process itself binds every interface (see SECURITY-REVIEW.md "Loopback binding"). Never
# edit that line in docker-compose.yml to widen it, and never run the app outside Docker without an
# equivalent firewall rule.
API_PORT=2785

# --- Database: SQLite, zero external service, matches "prove it here" ---
DATABASE_TYPE=sqlite
DATABASE_SYNCHRONIZE=false
POSTGRES_BUILTIN=false

# --- Engine — whatsapp-web.js, the lower ban-risk engine per OpenWA's own README (it drives a real
# headless Chromium). Steven links his own personal number and talks to Vanessa in his "Message
# Yourself" thread (context/decisions.md, 2026-09-23). OpenWA's README advises a dedicated number
# for any automated gateway; that trade-off is Steven's and is recorded there. Costs ~300-500 MB
# RAM; `baileys` is lighter but easier for WhatsApp to fingerprint. ---
ENGINE_TYPE=whatsapp-web.js
PUPPETEER_HEADLESS=true

# --- Storage: local disk, no S3/MinIO ---
STORAGE_TYPE=local
MINIO_BUILTIN=false

# --- Redis/queue: off — single self-chat, no fan-out need ---
REDIS_ENABLED=false
REDIS_BUILTIN=false
QUEUE_ENABLED=false
CACHE_ENABLED=false

# --- Never turn these on for this deployment ---
ALLOW_DEV_API_KEY=false
ENABLE_SWAGGER=false
MCP_ENABLED=false

# --- Webhook -> local n8n bridge (a later step; see BRIDGE.md once it exists). The SSRF guard
# blocks private and loopback targets; SSRF_ALLOWED_HOSTS is a comma-separated list of hostnames
# or IP literals matched against the webhook URL's hostname (src/common/security/ssrf-guard.ts).
# OpenWA runs INSIDE Docker, where 127.0.0.1 is the container itself, not the Mac: n8n running on
# the Mac is reached as http://host.docker.internal:5678/... . So the one named exception is
# host.docker.internal — nothing wider, and never a blanket WEBHOOK_SSRF_PROTECT=false. ---
WEBHOOK_SSRF_PROTECT=true
SSRF_ALLOWED_HOSTS=host.docker.internal

# --- Secrets: NAME only, value goes in the macOS keychain or OpenWA's own generated files, never
# here. provision-keys.sh reads/writes these; this repo never sees the value. ---
# API_MASTER_KEY=                    # leave UNSET — let OpenWA mint a random owa_k1_ admin key on first boot
# API_KEY_PEPPER=                    # optional HMAC pepper for stored key hashes; keychain item "openwa-api-key-pepper" if set
